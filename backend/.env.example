# ---------------------------------------------------------------------------
# CodeBot backend configuration.
#
# Copy this file to .env and fill in the real values:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
API_V1_PREFIX=/api

# --- Database (MongoDB Atlas) ---
# From Atlas: Cluster -> Connect -> Drivers -> copy the connection string.
# Replace <password> in the URI with the database user password, URL encoded.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DATABASE_NAME=codebot

# --- Authentication ---
# Generate a strong random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- AI ---
# This key is read by the backend only. It is never sent to the browser.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# --- CORS ---
# Comma separated list of frontend origins that may call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Input limits ---
MAX_CODE_LENGTH=20000
MAX_PROMPT_LENGTH=2000
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_CHAT_HISTORY_MESSAGES=20