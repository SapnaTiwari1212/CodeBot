# ---------------------------------------------------------------------------
# CodeBot frontend configuration.
#
# Copy this file to .env:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put a secret here. Vite inlines these values into the JavaScript bundle,
# so anything in this file is public.
# ---------------------------------------------------------------------------

# Base URL of the CodeBot backend. The API prefix (/api) is added by the client.
VITE_API_BASE_URL=http://127.0.0.1:8000